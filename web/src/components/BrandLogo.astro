---
/** 品牌标「双窗口 T」：引用 Base.astro 里的 SVG 精灵（<symbol id="tt-mark">），
 *  几何唯一来源是 brand/tongtop-mark.svg（经 src/brand/mark.ts 同步到桌面端）。
 *  圆的挖空由精灵里的 mask 负责，所以在浅底/深底上都成立。 */
interface Props {
  /** 视觉宽度（px）；标是 354:304，接近方形 */
  size?: number;
  class?: string;
}
const { size = 28, class: cls = "" } = Astro.props;
---
<svg
  class={`brand-logo ${cls}`}
  style={`width:${size}px;height:${(size * 304) / 354}px`}
  viewBox="0 0 354 304"
  aria-hidden="true"
>
  <use href="#tt-mark"></use>
</svg>
