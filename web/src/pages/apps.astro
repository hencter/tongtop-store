---
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import { APPS, CATEGORIES } from "../lib/data";
---
<Base title="软件库 · TongTop Store" description="精选软件目录，全部经 winget 官方源验证。">
  <h1 class="page-title">软件库</h1>
  <p class="page-sub">
    共 {APPS.length} 个精选条目，全部经 winget 官方源验证。点「复制安装命令」到终端即可安装，
    也可以直接在桌面客户端里一键装。
  </p>

  <div class="filters" id="cats" aria-label="软件分类">
    <button class="chip active" type="button" data-cat="all" aria-pressed="true">全部</button>
    {CATEGORIES.map((c) => <button class="chip" type="button" data-cat={c.id} aria-pressed="false">{c.label}</button>)}
  </div>

  <label class="sr-only" for="q">搜索软件</label>
  <input
    id="q"
    type="search"
    placeholder="搜索名称 / ID / 标签…"
    autocomplete="off"
    style="max-width:380px"
  />
  <div id="result-count" class="meta" aria-live="polite" style="margin-top:8px"></div>

  <div class="grid" id="grid" style="margin-top:18px">
    {
      APPS.map((app) => (
        <div
          class="app-cell"
          data-cat={app.category}
          data-ai={app.ai ? "1" : ""}
          data-text={`${app.name} ${app.id} ${app.desc} ${(app.tags ?? []).join(" ")}`.toLowerCase()}
        >
          <AppCard app={app} />
        </div>
      ))
    }
  </div>
  <p id="empty" class="muted hidden">没有匹配的条目。</p>
</Base>

<script>
  const grid = document.getElementById("grid");
  const cells = Array.from(grid?.querySelectorAll(".app-cell") ?? []);
  const chips = Array.from(document.querySelectorAll("#cats .chip"));
  const empty = document.getElementById("empty");
  const input = document.getElementById("q");
  const resultCount = document.getElementById("result-count");

  const initial = new URLSearchParams(location.search);
  const allowedCats = new Set(["all", "ai", ...chips.map((chip) => chip.dataset.cat).filter(Boolean)]);
  const requestedCat = initial.get("cat") || "all";
  let cat = allowedCats.has(requestedCat) ? requestedCat : "all";
  let query = (initial.get("q") || "").trim().toLowerCase();

  if (input instanceof HTMLInputElement) input.value = initial.get("q") || "";

  function syncUrl() {
    const params = new URLSearchParams(location.search);
    if (cat === "all") params.delete("cat");
    else params.set("cat", cat);

    const rawQuery = input instanceof HTMLInputElement ? input.value.trim() : "";
    if (rawQuery) params.set("q", rawQuery);
    else params.delete("q");

    const next = params.toString();
    history.replaceState(null, "", next ? `${location.pathname}?${next}` : location.pathname);
  }

  function apply() {
    let visible = 0;
    for (const cell of cells) {
      const okCat =
        cat === "all" || cell.dataset.cat === cat || (cat === "ai" && cell.dataset.ai === "1");
      const okQuery = !query || (cell.dataset.text || "").includes(query);
      const show = okCat && okQuery;
      cell.classList.toggle("hidden", !show);
      if (show) visible += 1;
    }

    empty?.classList.toggle("hidden", visible > 0);
    if (resultCount) resultCount.textContent = `显示 ${visible} / ${cells.length} 个条目`;

    for (const chip of chips) {
      const active = chip.dataset.cat === cat;
      chip.classList.toggle("active", active);
      chip.setAttribute("aria-pressed", active ? "true" : "false");
    }
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      cat = chip.dataset.cat || "all";
      syncUrl();
      apply();
    }),
  );

  input?.addEventListener("input", () => {
    query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : "";
    syncUrl();
    apply();
  });

  apply();
</script>
