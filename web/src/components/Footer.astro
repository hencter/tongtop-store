    <span class="footer-brand">
      <BrandLogo size={20} />
      © {year} 应用商店 TongTop Store · <span data-i18n="不托管安装包，只做官方下载链接分发">不托管安装包，只做官方下载链接分发</span>
    </span>
    <span>
      <a href="/submit" data-i18n="提交收录">提交收录</a> ·
      <a href="/review" data-i18n="审核入口">审核入口</a> ·
      <a href="https://github.com/hencter/tongtop-store">GitHub</a>
    </span>
  </div>
</footer>
