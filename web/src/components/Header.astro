---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "首页" },
  { href: "/apps", label: "软件库" },
  { href: "/agents", label: "智能体" },
  { href: "/ai", label: "AI 白嫖" },
  { href: "/mirrors", label: "镜像" },
  { href: "/community", label: "社区提交" },
  { href: "/download", label: "下载" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header">
  <div class="container">
    <a class="logo" href="/" aria-label="TongTop Store 首页">
      <span class="logo-mark" aria-hidden="true">T</span>
      <span>TongTop Store</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {links.map((l) => (
        <a
          href={l.href}
          class={isActive(l.href) ? "active" : ""}
          aria-current={isActive(l.href) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>
