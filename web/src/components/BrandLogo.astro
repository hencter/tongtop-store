---
/** 品牌标「通天路」：黑圆角底 + 青铜弧形大道 + AI 之星（与桌面端图标同源设计）。 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: cls = "" } = Astro.props;
---
<svg
  class={`brand-logo ${cls}`}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 512 512"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="bl-road" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#7E521A"></stop>
      <stop offset="0.55" stop-color="#B8792C"></stop>
      <stop offset="1" stop-color="#E9B563"></stop>
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="96" fill="#060606"></rect>
  <path fill="url(#bl-road)" d="M-27 538 L350 538 C81 296 242 54 538 -81 L447 -81 C188 108 -27 350 -27 538 Z"></path>
  <path d="M161 538 C27 323 215 81 492 -81" fill="none" stroke="#060606" stroke-width="20" stroke-linecap="round" stroke-dasharray="46 42"></path>
  <path fill="#F4D38F" d="M384 76 C388 108 404 124 436 128 C404 132 388 148 384 180 C380 148 364 132 332 128 C364 124 380 108 384 76 Z"></path>
</svg>
