---
import Base from "../layouts/Base.astro";
---
<Base title="审核入口 · TongTop Store" description="维护者审核提交队列。">
  <h1 class="page-title">审核入口</h1>
  <p class="page-sub">
    提交以 GitHub Issue 形式存放在仓库里（标签 pending / approved / rejected），审核通过后条目出现在
    <a href="/community">社区提交</a> 页；正式收录请把条目合并进仓库 data/ 下的 JSON。
    管理令牌保存在浏览器会话中，仅用于调用审核接口。
  </p>

  <div class="form" style="margin-bottom:24px">
    <div class="field">
      <label for="token">管理令牌 <span class="hint">服务端环境变量 ADMIN_TOKEN</span></label>
      <div class="copy-row">
        <input id="token" type="password" placeholder="ADMIN_TOKEN" autocomplete="off" />
        <button class="btn" type="button" id="save">保存并加载</button>
        <button class="btn" type="button" id="clear">清除</button>
      </div>
    </div>
  </div>

  <div class="filters" id="tabs" aria-label="审核状态">
    <button class="chip active" type="button" data-status="pending" aria-pressed="true">待审核</button>
    <button class="chip" type="button" data-status="approved" aria-pressed="false">已通过</button>
    <button class="chip" type="button" data-status="rejected" aria-pressed="false">已拒绝</button>
  </div>

  <div id="list" aria-live="polite"></div>
</Base>

<script>
  const tokenInput = document.getElementById("token");
  const saveBtn = document.getElementById("save");
  const clearBtn = document.getElementById("clear");
  const tabs = Array.from(document.querySelectorAll("#tabs .chip"));
  const list = document.getElementById("list");
  let status = "pending";

  if (tokenInput instanceof HTMLInputElement) {
    tokenInput.value = sessionStorage.getItem("adminToken") || "";
  }

  function externalHttpUrl(value) {
    if (typeof value !== "string" || !value) return null;
    try {
      const url = new URL(value);
      return url.protocol === "http:" || url.protocol === "https:" ? url.href : null;
    } catch {
      return null;
    }
  }

  function textElement(tag, className, text) {
    const el = document.createElement(tag);
    if (className) el.className = className;
    el.textContent = text;
    return el;
  }

  function showMessage(message, kind = "muted") {
    if (!list) return;
    const el = kind === "muted"
      ? textElement("p", "muted", message)
      : textElement("div", `notice ${kind}`, message);
    list.replaceChildren(el);
  }

  function render(items) {
    if (!list) return;
    if (!Array.isArray(items) || items.length === 0) {
      showMessage("没有记录。");
      return;
    }

    const fragment = document.createDocumentFragment();
    for (const item of items) {
      const article = document.createElement("article");
      article.className = "card";
      article.style.marginBottom = "12px";

      const row = document.createElement("div");
      row.className = "row";

      const main = document.createElement("div");
      main.style.flex = "1";
      main.style.minWidth = "0";
      main.appendChild(textElement("h3", "", String(item.name || "")));

      const ref = item.refId ? ` · ${item.refId}` : "";
      main.appendChild(
        textElement("div", "meta", `${item.type || ""} · ${item.createdAt || ""}${ref}`),
      );

      row.appendChild(main);
      row.appendChild(
        textElement("span", `badge ${item.status === "approved" ? "ok" : ""}`, String(item.status || "")),
      );
      article.appendChild(row);
      article.appendChild(textElement("p", "desc", String(item.desc || "")));

      const href = externalHttpUrl(item.site);
      if (href) {
        const meta = document.createElement("div");
        meta.className = "meta";
        const link = document.createElement("a");
        link.href = href;
        link.target = "_blank";
        link.rel = "noopener";
        link.textContent = href;
        meta.appendChild(link);
        article.appendChild(meta);
      }

      if (item.contact) {
        article.appendChild(textElement("div", "meta", `联系方式：${item.contact}`));
      }

      if (item.status === "pending") {
        const actions = document.createElement("div");
        actions.className = "actions";

        const approve = document.createElement("button");
        approve.type = "button";
        approve.className = "btn sm primary";
        approve.dataset.action = "approve";
        approve.dataset.id = String(item.id || "");
        approve.textContent = "通过";

        const reject = document.createElement("button");
        reject.type = "button";
        reject.className = "btn sm";
        reject.dataset.action = "reject";
        reject.dataset.id = String(item.id || "");
        reject.textContent = "拒绝";

        actions.append(approve, reject);
        article.appendChild(actions);
      }

      fragment.appendChild(article);
    }

    list.replaceChildren(fragment);
  }

  async function load() {
    const token = tokenInput instanceof HTMLInputElement ? tokenInput.value.trim() : "";
    if (!token) {
      showMessage("先填写管理令牌。");
      return;
    }

    sessionStorage.setItem("adminToken", token);
    showMessage("加载中…");
    try {
      const resp = await fetch(`/api/submissions?status=${encodeURIComponent(status)}`, {
        headers: { authorization: `Bearer ${token}` },
      });
      const json = await resp.json();
      if (!resp.ok || !json.ok) throw new Error(json.error || `HTTP ${resp.status}`);
      render(json.items);
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      showMessage(`加载失败：${message}`, "err");
    }
  }

  saveBtn?.addEventListener("click", load);
  clearBtn?.addEventListener("click", () => {
    sessionStorage.removeItem("adminToken");
    if (tokenInput instanceof HTMLInputElement) tokenInput.value = "";
    showMessage("管理令牌已从当前浏览器会话清除。");
  });

  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      status = tab.dataset.status || "pending";
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("active", active);
        item.setAttribute("aria-pressed", active ? "true" : "false");
      });
      void load();
    }),
  );

  list?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const btn = target.closest("[data-action]");
    if (!(btn instanceof HTMLButtonElement)) return;

    btn.disabled = true;
    try {
      const token = tokenInput instanceof HTMLInputElement ? tokenInput.value.trim() : "";
      const resp = await fetch("/api/review", {
        method: "POST",
        headers: {
          "content-type": "application/json",
          authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ id: btn.dataset.id, action: btn.dataset.action }),
      });
      const json = await resp.json();
      if (!resp.ok || !json.ok) throw new Error(json.error || `HTTP ${resp.status}`);
      await load();
    } catch (error) {
      btn.disabled = false;
      const message = error instanceof Error ? error.message : String(error);
      alert(`操作失败：${message}`);
    }
  });

  if (tokenInput instanceof HTMLInputElement && tokenInput.value) void load();
</script>
