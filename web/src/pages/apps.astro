---
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import { APPS, CATEGORIES } from "../lib/data";
---
<Base title="软件库 · TongTop Store" description="精选软件目录，全部经 winget 官方源验证。">
  <h1 class="page-title">软件库</h1>
  <p class="page-sub">
    共 {APPS.length} 个精选条目，全部经 winget 官方源验证。点「复制安装命令」到终端即可安装，
    也可以直接在桌面客户端里一键装。
  </p>

  <div class="filters" id="cats">
    <button class="chip active" data-cat="all">全部</button>
    {CATEGORIES.map((c) => <button class="chip" data-cat={c.id}>{c.label}</button>)}
  </div>
  <div class="filters" id="sorts">
    <button class="chip active" data-sort="default">默认</button>
    <button class="chip" data-sort="newest">最新收录</button>
  </div>
  <input id="q" type="search" placeholder="搜索名称 / ID / 标签…" style="max-width:380px" />

  <div class="grid" id="grid" style="margin-top:18px">
    {
      APPS.map((app) => (
        <div
          class="app-cell"
          data-cat={app.category}
          data-ai={app.ai ? "1" : ""}
          data-added={app.addedAt ?? ""}
          data-text={`${app.name} ${app.id} ${app.desc} ${(app.tags ?? []).join(" ")}`.toLowerCase()}
        >
          <AppCard app={app} />
        </div>
      ))
    }
  </div>
  <p id="empty" class="muted hidden">没有匹配的条目。</p>
</Base>

<script>
  const grid = document.getElementById("grid");
  const cells = Array.from(grid.querySelectorAll(".app-cell"));
  cells.forEach((cell, index) => {
    cell.dataset.idx = String(index);
  });
  const chips = Array.from(document.querySelectorAll("#cats .chip"));
  const sortChips = Array.from(document.querySelectorAll("#sorts .chip"));
  const empty = document.getElementById("empty");
  const input = document.getElementById("q");
  const params = new URLSearchParams(location.search);
  let cat = params.get("cat") || "all";
  let sort = params.get("sort") === "newest" ? "newest" : "default";
  // 顶栏搜索框跳转带来的关键词（?q=）：进入即过滤
  let query = params.get("q")?.trim().toLowerCase() || "";
  if (query) input.value = query;

  function applySort() {
    const ordered = [...cells].sort((a, b) => {
      const ai = Number(a.dataset.idx);
      const bi = Number(b.dataset.idx);
      if (sort !== "newest") return ai - bi;
      const addedA = a.dataset.added || "";
      const addedB = b.dataset.added || "";
      if (addedA === addedB) return ai - bi;
      if (!addedA) return 1;
      if (!addedB) return -1;
      return addedB.localeCompare(addedA);
    });
    for (const cell of ordered) grid.appendChild(cell);
    for (const chip of sortChips) chip.classList.toggle("active", chip.dataset.sort === sort);
  }

  function apply() {
    let visible = 0;
    for (const cell of cells) {
      const okCat =
        cat === "all" || cell.dataset.cat === cat || (cat === "ai" && cell.dataset.ai === "1");
      const okQuery = !query || cell.dataset.text.includes(query);
      const show = okCat && okQuery;
      cell.classList.toggle("hidden", !show);
      if (show) visible += 1;
    }
    empty.classList.toggle("hidden", visible > 0);
    for (const chip of chips) chip.classList.toggle("active", chip.dataset.cat === cat);
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      cat = chip.dataset.cat;
      apply();
    }),
  );
  sortChips.forEach((chip) =>
    chip.addEventListener("click", () => {
      sort = chip.dataset.sort === "newest" ? "newest" : "default";
      applySort();
    }),
  );
  input.addEventListener("input", () => {
    query = input.value.trim().toLowerCase();
    apply();
  });
  applySort();
  apply();
</script>
