---
import Icon from "./Icon.astro";
import { categoryLabel, pricingLabel, type AppEntry } from "../lib/data";

interface Props {
  app: AppEntry;
}
const { app } = Astro.props;
const cmd = `winget install --id ${app.id} -e`;
const facts = [
  app.publisher,
  app.license,
  app.addedAt ? `收录于 ${app.addedAt}` : "",
]
  .filter(Boolean)
  .join(" · ");
const price = app.pricing ? pricingLabel(app.pricing) : "";
const shot = app.screenshots?.[0];
---
<article class="card">
  <div class="row">
    <Icon id={app.id} name={app.name} />
    <div style="flex:1;min-width:0">
      <h3>{app.name}</h3>
      <div class="meta">{categoryLabel(app.category)}</div>
    </div>
    {app.ai && <span class="badge ai">AI</span>}
    {price && <span class="badge">{price}</span>}
  </div>
  <p class="desc">{app.desc}</p>
  {facts && <div class="meta">{facts}</div>}
  {shot && <img class="shot" src={shot} alt={`${app.name} 截图`} loading="lazy" onerror="this.remove()" />}
  <div class="actions">
    <button class="btn sm" data-copy-text={cmd} title={cmd}>复制安装命令</button>
    <a class="btn sm" href={app.site} target="_blank" rel="noopener">官网</a>
  </div>
</article>
