---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "首页" },
  { href: "/apps", label: "软件库" },
  { href: "/agents", label: "智能体" },
  { href: "/ai", label: "AI 白嫖" },
  { href: "/mirrors", label: "镜像" },
  { href: "/community", label: "社区提交" },
  { href: "/download", label: "下载" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header">
  <div class="container">
    <a class="logo" href="/">
      <span class="logo-mark">T</span>
      <span>TongTop Store</span>
    </a>
    <nav class="site-nav">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? "active" : ""}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
