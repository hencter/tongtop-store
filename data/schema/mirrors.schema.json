{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongtop.store/schema/mirrors.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools", "ghProxies"],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "desc", "presets", "official"],
        "properties": {
          "id": { "$ref": "https://tongtop.store/schema/common.schema.json#/$defs/id" },
          "name": { "$ref": "https://tongtop.store/schema/common.schema.json#/$defs/nonEmpty" },
          "desc": { "$ref": "https://tongtop.store/schema/common.schema.json#/$defs/nonEmpty" },
          "needsTool": { "$ref": "https://tongtop.store/schema/common.schema.json#/$defs/nonEmpty" },
          "presets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "$ref": "https://tongtop.store/schema/common.schema.json#/$defs/nonEmpty" },
                "value": { "$ref": "https://tongtop.store/schema/common.schema.json#/$defs/nonEmpty" },
                "note": { "type": "string" }
              }
            }
          },
          "official": { "type": "string" },
          "applyNote": { "type": "string" }
        }
      }
    },
    "ghProxies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "$ref": "https://tongtop.store/schema/common.schema.json#/$defs/nonEmpty" },
          "value": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
