---
import Base from "../layouts/Base.astro";
---
<Base title="审核入口 · TongTop Store" description="维护者审核提交队列。">
  <h1 class="page-title">审核入口</h1>
  <p class="page-sub">
    提交以 GitHub Issue 形式存放在仓库里（标签 pending / approved / rejected），审核通过后条目出现在
    <a href="/community">社区提交</a> 页；正式收录请把条目合并进仓库 data/ 下的 JSON。
    管理令牌保存在浏览器会话中，仅用于调用审核接口。
  </p>

  <div class="form" style="margin-bottom:24px">
    <div class="field">
      <label for="token">管理令牌 <span class="hint">服务端环境变量 ADMIN_TOKEN</span></label>
      <div class="copy-row">
        <input id="token" type="password" placeholder="ADMIN_TOKEN" autocomplete="off" />
        <button class="btn" id="save">保存并加载</button>
      </div>
    </div>
  </div>

  <div class="filters" id="tabs">
    <button class="chip active" data-status="pending">待审核</button>
    <button class="chip" data-status="approved">已通过</button>
    <button class="chip" data-status="rejected">已拒绝</button>
  </div>

  <div id="list"></div>
</Base>

<script>
  const tokenInput = document.getElementById("token");
  const saveBtn = document.getElementById("save");
  const tabs = Array.from(document.querySelectorAll("#tabs .chip"));
  const list = document.getElementById("list");
  let status = "pending";

  tokenInput.value = sessionStorage.getItem("adminToken") || "";

  /** URL 协议白名单：仅 http/https，其余（javascript:/data: 等）一律不渲染为链接 */
  function safeUrl(u) {
    try {
      const x = new URL(u);
      return x.protocol === "https:" || x.protocol === "http:" ? x.href : null;
    } catch {
      return null;
    }
  }

  // 安全渲染：全部经 DOM API + textContent（用户提交内容永不进 innerHTML）
  function cardOf(item) {
    const el = document.createElement("article");
    el.className = "card";
    el.style.marginBottom = "12px";

    const row = document.createElement("div");
    row.className = "row";
    const mid = document.createElement("div");
    mid.style.cssText = "flex:1;min-width:0";
    const h3 = document.createElement("h3");
    h3.textContent = item.name;
    const meta = document.createElement("div");
    meta.className = "meta";
    meta.textContent = `${item.type} · ${item.createdAt}${item.refId ? ` · ${item.refId}` : ""}`;
    mid.append(h3, meta);
    const badge = document.createElement("span");
    badge.className = `badge ${item.status === "approved" ? "ok" : ""}`;
    badge.textContent = item.status;
    row.append(mid, badge);
    el.append(row);

    const desc = document.createElement("p");
    desc.className = "desc";
    desc.textContent = item.desc;
    el.append(desc);

    const u = item.site ? safeUrl(item.site) : null;
    if (u) {
      const div = document.createElement("div");
      div.className = "meta";
      const a = document.createElement("a");
      a.href = u;
      a.target = "_blank";
      a.rel = "noopener";
      a.textContent = item.site;
      div.append(a);
      el.append(div);
    }
    if (item.contact) {
      const c = document.createElement("div");
      c.className = "meta";
      c.textContent = `联系方式:${item.contact}`;
      el.append(c);
    }
    if (item.status === "pending") {
      const actions = document.createElement("div");
      actions.className = "actions";
      for (const [action, label, cls] of [
        ["approve", "通过", "btn sm primary"],
        ["reject", "拒绝", "btn sm"],
      ]) {
        const b = document.createElement("button");
        b.className = cls;
        b.dataset.action = action;
        b.dataset.id = String(item.id);
        b.textContent = label;
        actions.append(b);
      }
      el.append(actions);
    }
    return el;
  }

  function render(items) {
    const frag = document.createDocumentFragment();
    if (items.length === 0) {
      const p = document.createElement("p");
      p.className = "muted";
      p.textContent = "没有记录。";
      frag.append(p);
    } else {
      for (const item of items) frag.append(cardOf(item));
    }
    list.replaceChildren(frag);
  }

  async function load() {
    const token = tokenInput.value.trim();
    if (!token) {
      list.textContent = "先填写管理令牌。";
      return;
    }
    sessionStorage.setItem("adminToken", token);
    list.textContent = "加载中…";
    try {
      const resp = await fetch(`/api/submissions?status=${status}`, {
        headers: { authorization: `Bearer ${token}` },
      });
      const json = await resp.json();
      if (!resp.ok || !json.ok) throw new Error(json.error || `HTTP ${resp.status}`);
      render(json.items);
    } catch (error) {
      const div = document.createElement("div");
      div.className = "notice err";
      div.textContent = `加载失败:${String(error.message || error)}`;
      list.replaceChildren(div);
    }
  }

  saveBtn.addEventListener("click", load);
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      status = tab.dataset.status;
      tabs.forEach((t) => t.classList.toggle("active", t === tab));
      load();
    }),
  );

  list.addEventListener("click", async (event) => {
    const btn = event.target.closest("[data-action]");
    if (!btn) return;
    btn.disabled = true;
    try {
      const resp = await fetch("/api/review", {
        method: "POST",
        headers: {
          "content-type": "application/json",
          authorization: `Bearer ${tokenInput.value.trim()}`,
        },
        body: JSON.stringify({ id: btn.dataset.id, action: btn.dataset.action }),
      });
      const json = await resp.json();
      if (!resp.ok || !json.ok) throw new Error(json.error || `HTTP ${resp.status}`);
      await load();
    } catch (error) {
      btn.disabled = false;
      alert(`操作失败:${String(error.message || error)}`);
    }
  });

  if (tokenInput.value) load();
</script>
