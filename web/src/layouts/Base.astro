---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "TongTop Store · 应用与 AI 智能体分发站",
  description = "精选软件目录、AI 智能体一键装机配方、国内镜像源、AI 模型免费额度与密钥配置引导。",
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- 品牌标 SVG 精灵：全站 <use href="#tt-mark"> 复用（几何与 brand/tongtop-mark.svg 一致） -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="tt-mark" viewBox="0 0 354 304">
        <mask id="tt-mark-dots" maskUnits="userSpaceOnUse" x="0" y="-53" width="354" height="304">
          <rect x="0" y="-53" width="354" height="304" fill="#fff"></rect>
          <circle cx="27" cy="45" r="9" fill="#000"></circle>
          <circle cx="65" cy="47" r="9" fill="#000"></circle>
          <circle cx="103" cy="49" r="9" fill="#000"></circle>
          <circle cx="150" cy="-20" r="8" fill="#000"></circle>
          <circle cx="180" cy="-20" r="8" fill="#000"></circle>
          <circle cx="210" cy="-20" r="8" fill="#000"></circle>
        </mask>
        <g mask="url(#tt-mark-dots)">
          <g transform="translate(0 53)">
            <path
              fill="#1E9BF0"
              fill-rule="evenodd"
              d="M104 3A56 56 0 0 1 160 -53H298A56 56 0 0 1 354 3V195A56 56 0 0 1 298 251H160A56 56 0 0 1 104 195Z M148 11A20 20 0 0 1 168 -9H290A20 20 0 0 1 310 11V187A20 20 0 0 1 290 207H168A20 20 0 0 1 148 187Z"
            ></path>
            <path
              fill="#0B2E6E"
              d="M0 22A22 22 0 0 1 22 0H215A22 22 0 0 1 237 22V60A22 22 0 0 1 215 82H158V228A22 22 0 0 1 136 250H106A22 22 0 0 1 84 228V82H22A22 22 0 0 1 0 60Z"
            ></path>
          </g>
        </g>
      </symbol>
    </svg>
    <Header />
    <main class="container page">
      <slot />
    </main>
    <Footer />
    <script>
      import { EN } from "../i18n";

      // 客户端 i18n：data-i18n 属性驱动，中文为原文（SSG），英文查表替换
      const originals = new WeakMap<object, string>();

      function applyLang(lang: string) {
        localStorage.setItem("tongtop.lang", lang);
        document.documentElement.lang = lang === "zh" ? "zh-CN" : "en";
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          if (!originals.has(el)) originals.set(el, el.textContent ?? "");
          const key = el.getAttribute("data-i18n") ?? "";
          el.textContent = lang === "en" ? (EN[key] ?? originals.get(el) ?? "") : originals.get(el)!;
        });
        document.querySelectorAll("[data-i18n-ph]").forEach((el) => {
          if (!originals.has(el)) originals.set(el, el.getAttribute("placeholder") ?? "");
          const key = el.getAttribute("data-i18n-ph") ?? "";
          el.setAttribute("placeholder", lang === "en" ? (EN[key] ?? originals.get(el)!) : originals.get(el)!);
        });
        const btn = document.getElementById("lang-toggle");
        if (btn) btn.textContent = lang === "zh" ? "EN" : "中";
      }

      (window as unknown as { __setLang: (l: string) => void }).__setLang = applyLang;
      // ?lang=en / ?lang=zh 可指定语言（分享链接/测试），否则读 localStorage/系统
      const urlLang = new URLSearchParams(location.search).get("lang");
      applyLang(
        urlLang === "en" || urlLang === "zh"
          ? urlLang
          : (localStorage.getItem("tongtop.lang") ??
              (navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en")),
      );

      document.getElementById("lang-toggle")?.addEventListener("click", () => {
        applyLang(localStorage.getItem("tongtop.lang") === "en" ? "zh" : "en");
      });
    </script>
    <script>
      // 全站复制：data-copy-text 直接复制其值；否则复制按钮所在 .copy-row 里的 <pre>
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const btn = target.closest("[data-copy-text], .copy-btn");
        if (!btn) return;
        const own = btn.getAttribute("data-copy-text");
        const text = own ?? btn.parentElement?.querySelector("pre")?.textContent ?? "";
        if (!text) return;
        navigator.clipboard.writeText(text.trim()).then(() => {
          const old = btn.textContent;
          btn.textContent = "已复制";
          setTimeout(() => (btn.textContent = old), 1200);
        });
      });
    </script>
  </body>
</html>
