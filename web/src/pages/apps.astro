---
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import { APPS, CATEGORIES } from "../lib/data";
---
<Base title="软件库 · TongTop Store" description="精选软件目录，全部经 winget 官方源验证。">
  <h1 class="page-title">软件库</h1>
  <p class="page-sub">
    共 {APPS.length} 个精选条目，全部经 winget 官方源验证。带许可证的条目在 2026-11-03 核对过仓库许可证、
    star 数或上游说明。点「复制安装命令」到终端即可安装，也可以直接在桌面客户端里一键装。
  </p>
  <p class="page-sub">
    RustDesk 在 2026-11-03 被 X 用户 @_guillecasaus 当成免费开源的远程控制推荐（GitHub rustdesk/rustdesk，AGPL-3.0，当天 128018 stars），但 winget 没有正式包，所以没有放进一键安装。
    ArtCraft 套件（GitHub storytold，仓库里同时有 LICENSE-MIT 和 LICENSE-APACHE）当天用 winget search ArtCraft 只返回 8 个包。ArtCraft 本体（storytold/artcraft，38479 stars，最新 Windows 安装包仍是 2026-09-26 的 v0.41.0）、PhotoCraft（76482 stars）、WordCraft、DesignCraft、FigCraft、DeckCraft 在 GitHub 有 Windows 安装包，winget 没有对应包。PdfCraft、GridCraft、CADCraft、SoundCraft 的 winget 版本落后于当天的 GitHub tag。X @JoeBuildsAI 当天写道这套仍是 alpha，大约一半目标流程还没就绪。
    REA（morluto/rea，MIT，https://rea.tools，当天 425747 stars，安装命令是 npx rea-agents setup）不是 winget 桌面程序。它用到的 Ghidra（NationalSecurityAgency/ghidra，Apache-2.0，97438 stars）同样没有 winget 包。目录里能一键装的是 Cutter、jadx、ImHex、x64dbg、ILSpy、dnSpy、Detect It Easy 和 PE-bear。
  </p>

  <div class="filters" id="cats">
    <button class="chip active" data-cat="all">全部</button>
    <button class="chip" data-cat="oss" data-i18n="开源">开源</button>
    {CATEGORIES.map((c) => <button class="chip" data-cat={c.id}>{c.label}</button>)}
  </div>
  <input id="q" type="search" placeholder="搜索名称 / ID / 标签…" style="max-width:380px" />

  <div class="grid" id="grid" style="margin-top:18px">
    {
      APPS.map((app) => (
        <div
          class="app-cell"
          data-cat={app.category}
          data-ai={app.ai ? "1" : ""}
          data-oss={app.oss ? "1" : ""}
          data-text={`${app.name} ${app.id} ${app.desc} ${(app.tags ?? []).join(" ")}`.toLowerCase()}
        >
          <AppCard app={app} />
        </div>
      ))
    }
  </div>
  <p id="empty" class="muted hidden">没有匹配的条目。</p>
</Base>

<script>
  const grid = document.getElementById("grid");
  const cells = Array.from(grid.querySelectorAll(".app-cell"));
  const chips = Array.from(document.querySelectorAll("#cats .chip"));
  const empty = document.getElementById("empty");
  const input = document.getElementById("q");
  let cat = new URLSearchParams(location.search).get("cat") || "all";
  // 顶栏搜索框跳转带来的关键词（?q=）：进入即过滤
  let query = new URLSearchParams(location.search).get("q")?.trim().toLowerCase() || "";
  if (query) input.value = query;

  function apply() {
    let visible = 0;
    for (const cell of cells) {
      const okCat =
        cat === "all" ||
        cell.dataset.cat === cat ||
        (cat === "ai" && cell.dataset.ai === "1") ||
        (cat === "oss" && cell.dataset.oss === "1");
      const okQuery = !query || cell.dataset.text.includes(query);
      const show = okCat && okQuery;
      cell.classList.toggle("hidden", !show);
      if (show) visible += 1;
    }
    empty.classList.toggle("hidden", visible > 0);
    for (const chip of chips) chip.classList.toggle("active", chip.dataset.cat === cat);
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      cat = chip.dataset.cat;
      apply();
    }),
  );
  input.addEventListener("input", () => {
    query = input.value.trim().toLowerCase();
    apply();
  });
  apply();
</script>
