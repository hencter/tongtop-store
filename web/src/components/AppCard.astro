---
import Icon from "./Icon.astro";
import { categoryLabel, type AppEntry } from "../lib/data";

interface Props {
  app: AppEntry;
}
const { app } = Astro.props;
const cmd = app.download ? null : `winget install --id ${app.id} -e`;
---
<article class="card">
  <div class="row">
    <Icon id={app.id} name={app.name} />
    <div style="flex:1;min-width:0">
      <h3>{app.name}</h3>
      <div class="meta">{categoryLabel(app.category)}</div>
    </div>
    <div style="display:flex;gap:6px;align-items:center">
      {app.official && <span class="badge">官方</span>}
      {app.ai && <span class="badge ai">AI</span>}
    </div>
  </div>
  <p class="desc">{app.desc}</p>
  <div class="actions">
    {app.download ? (
      <a class="btn sm" href={app.download.url} target="_blank" rel="noopener">
        官方下载{app.download.platform ? ` · ${app.download.platform}` : ""}
      </a>
    ) : (
      <button class="btn sm" data-copy-text={cmd} title={cmd ?? undefined}>复制安装命令</button>
    )}
    <a class="btn sm" href={app.site} target="_blank" rel="noopener">官网</a>
  </div>
</article>
