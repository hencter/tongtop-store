---
import Base from "../layouts/Base.astro";
---
<Base title="社区提交 · TongTop Store" description="社区提交并通过审核的软件、智能体与情报。">
  <h1 class="page-title">社区提交</h1>
  <p class="page-sub">
    社区提交并审核通过的条目。想补充？去 <a href="/submit">提交收录</a>。
  </p>

  <div id="list" style="margin-top:20px"><p class="muted">加载中…</p></div>
</Base>

<script>
  const list = document.getElementById("list");
  const TYPE_LABEL = {
    app: "软件",
    agent: "智能体",
    "free-model": "免费额度",
    correction: "纠错",
  };

  function externalHttpUrl(value) {
    if (typeof value !== "string" || !value) return null;
    try {
      const url = new URL(value);
      return url.protocol === "http:" || url.protocol === "https:" ? url.href : null;
    } catch {
      return null;
    }
  }

  function textElement(tag, className, text) {
    const el = document.createElement(tag);
    if (className) el.className = className;
    el.textContent = text;
    return el;
  }

  function showMessage(message) {
    if (!list) return;
    const p = textElement("p", "muted", message);
    list.replaceChildren(p);
  }

  function render(items) {
    if (!list) return;
    if (!Array.isArray(items) || items.length === 0) {
      showMessage("还没有已通过的社区提交。");
      return;
    }

    const fragment = document.createDocumentFragment();
    for (const item of items) {
      const article = document.createElement("article");
      article.className = "card";
      article.style.marginBottom = "12px";

      const row = document.createElement("div");
      row.className = "row";

      const main = document.createElement("div");
      main.style.flex = "1";
      main.style.minWidth = "0";
      main.appendChild(textElement("h3", "", String(item.name || "")));

      const typeLabel = TYPE_LABEL[item.type] || item.type || "";
      const reviewed = typeof item.reviewedAt === "string" ? item.reviewedAt.slice(0, 10) : "";
      const ref = item.refId ? ` · ${item.refId}` : "";
      main.appendChild(textElement("div", "meta", `${typeLabel} · 通过于 ${reviewed}${ref}`));

      row.appendChild(main);
      row.appendChild(textElement("span", "badge ok", "已收录"));
      article.appendChild(row);
      article.appendChild(textElement("p", "desc", String(item.desc || "")));

      const href = externalHttpUrl(item.site);
      if (href) {
        const meta = document.createElement("div");
        meta.className = "meta";
        const link = document.createElement("a");
        link.href = href;
        link.target = "_blank";
        link.rel = "noopener";
        link.textContent = href;
        meta.appendChild(link);
        article.appendChild(meta);
      }

      fragment.appendChild(article);
    }
    list.replaceChildren(fragment);
  }

  fetch("/api/submissions?status=approved")
    .then((resp) => resp.json())
    .then((json) => {
      if (!json.ok) {
        showMessage("社区提交暂时不可用。");
        return;
      }
      render(json.items);
    })
    .catch(() => {
      showMessage("加载失败（审核接口未部署时属正常）。");
    });
</script>
